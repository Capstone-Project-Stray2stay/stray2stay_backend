JWT_SECRET=
BCRYPT_COST=
ENV=

# Database configuration
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google AI Studio (Gemini) — optional.
# Without GEMINI_API_KEY the server still starts and AI adoption summaries
# are skipped. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Flash models routinely take 30-60s under load; too low a ceiling turns a
# slow-but-successful call into a timeout.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
